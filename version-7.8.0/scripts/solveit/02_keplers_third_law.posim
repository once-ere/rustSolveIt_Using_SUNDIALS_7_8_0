# 2. Kepler's third law: T^2 / a^3 is one number for every orbit.
# Four CIRCULAR orbits of radius a = 1, 2, 3, 4 about the same sun.
# For a circle v = sqrt(GM/a) and T = 2 pi a^(3/2)/sqrt(GM); with
# G = 1 and M = 1000 the four periods are 0.19869..., 0.56198...,
# 1.03235..., 1.58953... . Each planet is run for ITS OWN period and
# must come home to where it started.
set system.g_constant = 1
new sphere as sun { mass = 1000, radius = 0.2 }
new sphere as p1  { mass = 0.000001, radius = 0.02, position = [1, 0, 0], velocity = [0, 0, 31.622776601683793] }
run 0.19869176531592203 steps 200
get p1.position
reset
set system.g_constant = 1
new sphere as sun { mass = 1000, radius = 0.2 }
new sphere as p2  { mass = 0.000001, radius = 0.02, position = [2, 0, 0], velocity = [0, 0, 22.360679774997898] }
run 0.5619851784832581 steps 200
get p2.position
reset
set system.g_constant = 1
new sphere as sun { mass = 1000, radius = 0.2 }
new sphere as p3  { mass = 0.000001, radius = 0.02, position = [3, 0, 0], velocity = [0, 0, 18.257418583505537] }
run 1.0324326977181857 steps 200
get p3.position
reset
set system.g_constant = 1
new sphere as sun { mass = 1000, radius = 0.2 }
new sphere as p4  { mass = 0.000001, radius = 0.02, position = [4, 0, 0], velocity = [0, 0, 15.811388300841896] }
run 1.5895341225273762 steps 200
get p4.position
# T^2/a^3 for each, in-language: all four must be the same number
0.19869176531592203 * 0.19869176531592203 / 1
0.5619851784832581 * 0.5619851784832581 / (2 * 2 * 2)
1.0324326977181857 * 1.0324326977181857 / (3 * 3 * 3)
1.5895341225273762 * 1.5895341225273762 / (4 * 4 * 4)
