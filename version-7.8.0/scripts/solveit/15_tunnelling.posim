# 15. Tunnelling through a square barrier, checked against the textbook
# transfer-matrix formula -- and against ITSELF as the grid refines.
# Barrier V0 = 4 on [0, 1], hbar = m = 1. For E < V0,
#   T = 1 / (1 + V0^2 sinh^2(kappa a) / (4 E (V0 - E))),  kappa = sqrt(2(V0-E))
# At E = 2 that is 0.07065082485316446.
qm mass 1
qm hbar 1
# the analytic value first, built from the language's own builtins
let v0 = 4
let e = 2
let kappa = sqrt(2 * (v0 - e))
let s = (exp(kappa) - exp(-kappa)) / 2
1 / (1 + v0 * v0 * s * s / (4 * e * (v0 - e)))
# now the solver, on three grids. The barrier edges land between grid
# points, so a coarse grid gets an effective width that is off by up to
# one h -- and T depends on that width EXPONENTIALLY. Refine and watch.
qm grid -30 30 4000
qm potential barrier 4, 0, 1
qm transmission 2
qm grid -30 30 16000
qm potential barrier 4, 0, 1
qm transmission 2
qm grid -30 30 64000
qm potential barrier 4, 0, 1
qm transmission 2
# above the barrier T returns to exactly 1 at the resonances
qm grid -30 30 16000
qm potential barrier 4, 0, 1
qm scan 4.1 20 200
