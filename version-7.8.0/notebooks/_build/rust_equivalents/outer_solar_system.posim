# The outer solar system: Sun with the inner planets lumped into it, then
# Jupiter, Saturn, Uranus, Neptune and Pluto, integrated for 500,000 days
# -- about 1,370 years.
#
# Units are astronomical: AU for length, days for time, solar masses for
# mass, which is why G = 2.95912208286e-4 rather than anything familiar.
# Softening is zero, because the donor problem is unsoftened and nothing
# here comes close enough to need it.
#
# This is the standard N-body benchmark: every pair attracts every other,
# so the right-hand side is 15 pairwise forces, and the test is whether
# the total energy holds over a very long integration. The anchor for
# this repository is Pluto at x = 31.78592516, y = 38.63618957,
# z = 3.19279415 with an energy drift of 7.835809e-07 after 12581
# internal steps -- byte-identical to the value the 7.7.0 engine gave.
set system.g_constant = 2.95912208286e-4
set system.softening = 0
set system.rtol = 1e-10
set system.atol = 1e-12
collide off
new point as sun { mass = 1.00000597682, position = [0, 0, 0], velocity = [0, 0, 0] }
new point as jupiter { mass = 9.54786104043e-4, position = [-3.5023653, -3.8169847, -1.5507963], velocity = [0.00565429, -0.00412490, -0.00190589] }
new point as saturn { mass = 2.85583733151e-4, position = [9.0755314, -3.0458353, -1.6483708], velocity = [0.00168318, 0.00483525, 0.00192462] }
new point as uranus { mass = 4.37273164546e-5, position = [8.3101420, -16.2901086, -7.2521278], velocity = [0.00354178, 0.00137102, 0.00055029] }
new point as neptune { mass = 5.17759138449e-5, position = [11.4707666, -25.7294829, -10.8169456], velocity = [0.00288930, 0.00114527, 0.00039677] }
new point as pluto { mass = 7.692307692307693e-9, position = [-15.5387357, -25.2225594, -3.1902382], velocity = [0.00276725, -0.00170702, -0.00136504] }
method adams
energy
com
run 500000 steps 10
get pluto.position
energy
com
