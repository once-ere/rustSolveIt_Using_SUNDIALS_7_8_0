# Equal masses head-on: velocities exchange exactly — dynamic notebook
#
# Two identical spheres (m = 1, r = 0.5) approach at ±1 with gravity off.
# Surface gap = 3, closing speed = 2, so they touch at t = 1.5 exactly;
# the elastic impulse (e = 1) acts along the contact normal and the
# velocities EXCHANGE — each ball leaves with the other's velocity.
# Watch the hud: P stays [0,0,0] and E stays 1.0 through the impact;
# press C (or the Contacts button) to see the golden action-reaction
# arrows flash at the touch.
#
# Launch:   posim_notebook head_on_exchange
#     or:   cargo run -p posim --release -- --notebook dynamic_notebooks/head_on_exchange.posim
# Press Start in the scene window (or type SCENE START here) to run
# and display the simulation.

set system.g_constant = 0
new sphere { mass = 1, radius = 0.5, position = [-2, 0, 0], velocity = [1, 0, 0] }
new sphere { mass = 1, radius = 0.5, position = [2, 0, 0], velocity = [-1, 0, 0] }
collide

# Baselines before running: total momentum is zero, kinetic energy is
# 2 x (1/2 * 1 * 1^2) = 1 — both must be unchanged after the exchange.
momentum
energy

scene create
