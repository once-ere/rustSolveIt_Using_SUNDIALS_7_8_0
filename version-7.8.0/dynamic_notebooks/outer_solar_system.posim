# The outer solar system — dynamic notebook
#
# The classic DE118-era test problem (Applegate et al. units: AU, days,
# solar masses): the Sun (+ inner planets folded in), Jupiter, Saturn,
# Uranus, Neptune and Pluto, G = 2.95912208286e-4, unsoftened. The
# self-checking Rust example (posim_example outer_solar_system)
# certifies |dE/E| < 1e-6 over 500,000 days and pins Pluto's position
# to eight decimals against the donor solar_system run; this notebook
# is the same system, watched live. At 50 days per playback tick
# (~30 ticks/s) Jupiter laps in ~3 wall-seconds, Saturn in ~7,
# Uranus in ~20, Neptune in ~40 and Pluto in about a minute.
# Watch the hud: E holds at -3.2155e-8 while the giants circulate.
#
# Launch:   posim_notebook outer_solar_system
#     or:   cargo run -p posim --release -- --notebook dynamic_notebooks/outer_solar_system.posim
# Press Start in the scene window (or type SCENE START here) to run
# and display the simulation.
#
# (Naming adaptation only: AS names label the bodies in the window;
# masses, positions and velocities are the Rust example's verbatim.)

new point as sun { mass = 1.00000597682 }
new point as jupiter { mass = 9.54786104043e-4, position = [-3.5023653, -3.8169847, -1.5507963], velocity = [0.00565429, -0.00412490, -0.00190589] }
new point as saturn { mass = 2.85583733151e-4, position = [9.0755314, -3.0458353, -1.6483708], velocity = [0.00168318, 0.00483525, 0.00192462] }
new point as uranus { mass = 4.37273164546e-5, position = [8.3101420, -16.2901086, -7.2521278], velocity = [0.00354178, 0.00137102, 0.00055029] }
new point as neptune { mass = 5.17759138449e-5, position = [11.4707666, -25.7294829, -10.8169456], velocity = [0.00288930, 0.00114527, 0.00039677] }
new point as pluto { mass = 1 / 1.3e8, position = [-15.5387357, -25.2225594, -3.1902382], velocity = [0.00276725, -0.00170702, -0.00136504] }
set system.g_constant = 2.95912208286e-4
set system.softening = 0
set system.rtol = 1e-10
set system.atol = 1e-12

# Baselines before anything moves: the tiny negative total energy of a
# bound system, the (non-zero) barycentric drift momentum the donor
# initial data carries, and the center of mass.
energy
momentum
com

scene create
scene set_time_step 50
